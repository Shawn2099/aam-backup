# ═══════════════════════════════════════════════════
# Backup Automation System — Environment Variables
# ═══════════════════════════════════════════════════
# Copy this file to .env and fill in the values.
# Used during deployment on Windows Server 2016.
# ═══════════════════════════════════════════════════

# --- Prefect Server ---
# URL for the Prefect API (used by worker and UI)
PREFECT_API_URL=http://127.0.0.1:4200/api

# Prefect server database connection (SQLite)
PREFECT_API_DATABASE_CONNECTION_URL=sqlite+aiosqlite:///C:/BackupAgent/prefect.db

# Prefect server bind address and port
PREFECT_SERVER_API_HOST=0.0.0.0
PREFECT_SERVER_API_PORT=4200

# Prefect logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
PREFECT_LOGGING_LEVEL=WARNING

# --- Backup Agent ---
# Directory for backup log files (used by flow.py if BACKUP_LOG_DIR is set)
BACKUP_LOG_DIR=C:\BackupAgent\logs

# Path to config.yaml (optional — defaults to config.yaml in working directory)
BACKUP_CONFIG_PATH=C:\BackupAgent\config.yaml

# --- Python Path (for NSSM service configuration) ---
# These are set in install_services.bat, not in .env
# PYTHON_EXE=C:\Python311\python.exe
# PREFECT_EXE=C:\Python311\Scripts\prefect.exe

# --- GCS Service Account ---
# Path to GCS service account JSON key file
# Stored in Windows Credential Manager, not in .env
# Credential name: BackupAgent_GCS
# Value: C:\BackupAgent\gcs_service_account.json

# --- SMTP Credentials ---
# Stored in Windows Credential Manager, not in .env
# Credential name: BackupAgent_SMTP
